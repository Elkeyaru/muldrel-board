# Copia este archivo a ".env" y rellena con las claves de tu proyecto de Firebase
# (Configuración del proyecto > tus apps > SDK setup and configuration > Config).
# Es gratis, no necesita tarjeta. Ver instrucciones en README.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
